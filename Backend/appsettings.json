{
    "Logging": {
        "LogLevel": {
            "Default": "Warning",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "Serilog": {
        "MinimumLevel": {
            "Default": "Warning",
            "Override": {
                "Microsoft.AspNetCore": "Warning"
            }
        },
        "WriteTo": [
            { "Name": "Console" }
        ]
    },
    "Features": {
        "Debugging": false
    },
    "GameLoop": {
        "PollingIntervalMs": 1000
    },
    "Urls": "http://localhost:5000",
    "Emulator": {
        "Type": "RetroArch",
        "Duckstation": {
            "ProcessName": "duckstation-qt-x64-ReleaseLTCG"
        },
        "RetroArch": {
            "Host": "127.0.0.1",
            "Port": 55355,
            "Core": "BeetlePSX"
        }
    },
    "AllowedHosts": "*"
}
